//
// CheckBox — boolean tick. Public API: `checked`, signal `toggled`.
// Use:  CheckBox { checked: true; onToggled: opt = checked }
Rectangle {
    id: control

    property bool checked: false
    signal toggled

    width: 28
    height: 28
    radius: 6
    color: "#22304d"
    border.width: 2
    border.color: control.checked ? "#4fc3f7" : "#3a4a6b"

    Rectangle {
        width: 14
        height: 14
        radius: 3
        anchors.centerIn: parent
        color: "#4fc3f7"
        visible: control.checked
    }

    MouseArea {
        anchors.fill: parent
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
