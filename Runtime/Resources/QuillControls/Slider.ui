//
// Slider — drag to set `value` (0..1). Public API: `value`, signal `moved`.
// Use:  Slider { width: 230; value: 0.5; onMoved: volume = value }
Rectangle {
    id: control

    property real value: 0.4
    signal moved

    width: 200
    height: 36
    color: "#00000000"   // transparent hit region

    // track
    Rectangle {
        height: 8
        radius: 4
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        color: "#37474f"
        // fill
        Rectangle {
            height: 8
            radius: 4
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: parent.width * control.value
            color: "#4fc3f7"
        }
    }

    // handle
    Rectangle {
        width: 20
        height: 20
        radius: 10
        color: ma.pressed ? "#bbdefb" : "#e8eef7"
        anchors.verticalCenter: parent.verticalCenter
        x: control.value * control.width - 10
    }

    MouseArea {
        id: ma
        anchors.fill: parent
        onPressed: { control.value = Math.clamp(ma.mouseX / control.width, 0, 1); control.moved() }
        onPositionChanged: { control.value = Math.clamp(ma.mouseX / control.width, 0, 1); control.moved() }
    }
}
