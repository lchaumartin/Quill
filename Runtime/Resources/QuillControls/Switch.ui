//
// Switch — toggle. Public API: `checked`, signal `toggled`.
// Use:  Switch { checked: true; onToggled: setting = checked }
Rectangle {
    id: control

    property bool checked: false
    signal toggled

    width: 56
    height: 28
    radius: 14
    color: control.checked ? "#2e7d32" : "#37474f"

    Rectangle {
        width: 22
        height: 22
        radius: 11
        color: "#e8eef7"
        anchors.verticalCenter: parent.verticalCenter
        x: control.checked ? 30 : 4
    }

    MouseArea {
        anchors.fill: parent
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
