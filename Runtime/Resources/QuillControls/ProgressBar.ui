//
// ProgressBar — read-only fill. Public API: `value` (0..1).
// Use:  ProgressBar { width: 240; value: load }
Rectangle {
    id: control

    property real value: 0.5

    width: 220
    height: 12
    radius: 6
    color: "#37474f"

    Rectangle {
        height: 12
        radius: 6
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: parent.width * control.value
        color: "#66bb6a"
    }
}
