//
// CheckBox — Slate. Same API in every theme:
//   text (string, optional caption), checked (bool), enabled (bool), signal toggled
// Use:  CheckBox { text: "Subtitles"; checked: true; onToggled: subtitles = checked }
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    width: box.width + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(box.height, label.contentHeight)
    opacity: control.enabled ? 1 : 0.4

    Rectangle {
        id: box
        width: 22
        height: 22
        radius: Theme.radius * 0.6
        anchors.verticalCenter: parent.verticalCenter
        color: control.checked ? Theme.accent : Theme.control
        border.width: control.checked ? 0 : Theme.borderWidth
        border.color: area.containsMouse ? Qt.lighter(Theme.border, 1.6) : Theme.border
        Behavior on color { ColorAnimation { duration: Theme.duration } }

        // The mark grows in from the centre.
        Rectangle {
            property real size: control.checked ? 10 : 0
            Behavior on size { NumberAnimation { duration: Theme.duration; easing.type: Easing.OutBack } }
            width: size
            height: size
            radius: 2
            anchors.centerIn: parent
            color: Theme.accentText
            visible: size > 0.5
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: box.right
        anchors.leftMargin: 12
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
