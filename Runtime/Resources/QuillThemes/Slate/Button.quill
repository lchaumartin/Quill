//
// Button — Slate. Same API in every theme:
//   text (string), highlighted (bool: the primary action), enabled (bool)
//   down, hovered (bool, read-only), signal clicked
// Use:  Button { text: "Play"; highlighted: true; onClicked: startGame() }
Rectangle {
    id: control

    property string text: "Button"
    property bool highlighted: false
    property bool enabled: true
    property bool down: area.pressed
    property bool hovered: area.containsMouse
    signal clicked

    // Keyboard / gamepad: Tab or the D-pad reaches it; Space / Return (gamepad South) clicks.
    activeFocusOnTab: true
    Keys.onSpacePressed: control.clicked()
    Keys.onReturnPressed: control.clicked()
    Keys.onEnterPressed: control.clicked()

    width: Math.max(96, label.contentWidth + 40)
    height: 40
    radius: Theme.radius
    opacity: control.enabled ? 1 : 0.4
    color: control.highlighted
        ? (control.down ? Color.darker(Theme.accent, 1.2) : control.hovered ? Color.lighter(Theme.accent, 1.12) : Theme.accent)
        : (control.down ? Theme.control : control.hovered ? Theme.controlHover : Theme.control)
    border.width: control.highlighted ? 0 : Theme.borderWidth
    border.color: control.hovered ? Color.lighter(Theme.border, 1.5) : Theme.border
    Behavior on color { ColorAnimation { duration: Theme.duration } }

    Text {
        id: label
        text: control.text
        color: control.highlighted ? Theme.accentText : Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.centerIn: parent
        anchors.verticalCenterOffset: control.down ? 1 : 0
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: control.clicked()
    }

    FocusRing { visible: control.visualFocus }
}
