//
// Panel — a card to group controls on. Same API in every theme: size it, put children in it.
// Keep content Theme.padding in from the edges so every theme's frame has room:
//   Panel {
//       width: 340; height: content.height + 2 * Theme.padding
//       Column { id: content; x: Theme.padding; y: Theme.padding; spacing: Theme.spacing; … }
//   }
Item {
    id: panel

    width: 340
    height: 200

    // A soft drop shadow under the card.
    Rectangle {
        y: 6
        width: panel.width
        height: panel.height
        radius: Theme.radius * 1.5
        softness: 28
        color: "#00000073"
    }

    Rectangle {
        width: panel.width
        height: panel.height
        radius: Theme.radius * 1.5
        color: Theme.surface
        border.width: Theme.borderWidth
        border.color: Theme.border
    }
}
