//
// GlassLevel — a vertical level slider made of eight stacked glass cells that fill bottom-up.
// Drag anywhere on it to set `value` (0..1). The percentage fades in while hovered or dragged.
// Public API: `value`, `glyph`, signal `moved`.
// Use:  GlassLevel { glyph: "☼"; value: 0.7; onMoved: brightness = value }
Item {
    id: level

    property real value: 0.5
    property string glyph: ""
    signal moved

    width: 96
    height: 208

    // Cells are separated by a 6 px gap; `lit` is how many of the eight are filled.
    property real cell: (level.height - 42) / 8
    property real lit: Math.round(level.value * 8)

    property real hover
    property real hoverTarget: drag.containsMouse || drag.pressed ? 1 : 0

    Repeater {
        model: 8
        GlassPane {
            x: 0
            y: level.height - (index + 1) * (level.cell + 6) + 6
            width: level.width
            height: level.cell
            cornerRadius: index == 0 || index == 7 ? 18 : 7
            refraction: 10 + 6 * level.hover
            active: index < level.lit
            activeTint: "#f4f6ffdc"
            restTint: "#0a0f1e40"
        }
    }

    Text {
        text: level.glyph
        fontSize: 17
        color: level.lit >= 1 ? "#1a2040" : "#ffffff"
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.bottom
        anchors.verticalCenterOffset: -level.cell * 0.5
    }
    Text {
        text: Math.round(level.value * 100) + "%"
        fontSize: 12
        color: level.lit >= 8 ? "#1a2040" : "#ffffff"
        opacity: level.hover
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.top
        anchors.verticalCenterOffset: level.cell * 0.5
    }

    MouseArea {
        id: drag
        anchors.fill: parent
        // No hoverEnabled: `containsMouse` still tracks hover, and position events only arrive
        // while the area holds the press — i.e. during a drag.
        onPressed: { level.value = Math.clamp(1 - drag.mouseY / drag.height, 0, 1); level.moved() }
        onPositionChanged: { level.value = Math.clamp(1 - drag.mouseY / drag.height, 0, 1); level.moved() }
    }
}
