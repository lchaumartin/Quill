//
// GlassChip — a wide glass pill toggle: glyph on the left, a title and a state line beside it.
// Public API: `checked`, `glyph`, `title`, `detailOn`, `detailOff`, `accent`, signal `toggled`.
// Use:  GlassChip { title: "Focus"; detailOn: "Do Not Disturb"; onToggled: dnd = checked }
Item {
    id: chip

    property bool checked: false
    property string glyph: ""
    property string title: ""
    property string detailOn: "On"
    property string detailOff: "Off"
    property color accent: "#7b5cffcc"
    signal toggled

    width: 208
    height: 96

    GlassPane {
        anchors.fill: parent
        corner: chip.height * 0.5
        interactive: true
        active: chip.checked
        activeTint: chip.accent
        onClicked: { chip.checked = !chip.checked; chip.toggled() }
    }

    Text {
        text: chip.glyph
        fontSize: 24
        color: "#ffffff"
        anchors.horizontalCenter: parent.left
        anchors.horizontalCenterOffset: 44
        anchors.verticalCenter: parent.verticalCenter
    }
    Text {
        text: chip.title
        fontSize: 16
        color: "#ffffff"
        anchors.left: parent.left
        anchors.leftMargin: 78
        anchors.top: parent.top
        anchors.topMargin: 27
    }
    Text {
        text: chip.checked ? chip.detailOn : chip.detailOff
        fontSize: 12
        color: "#ffffffb3"
        anchors.left: parent.left
        anchors.leftMargin: 78
        anchors.top: parent.top
        anchors.topMargin: 51
    }
}
