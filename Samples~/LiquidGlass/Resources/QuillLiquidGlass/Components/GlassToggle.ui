//
// GlassToggle — a round glass bubble with a glyph and a caption. Lights up in `accent` when on.
// Public API: `checked`, `glyph`, `label`, `accent`, signal `toggled`.
// Use:  GlassToggle { glyph: "≈"; label: "Wi-Fi"; checked: true; onToggled: wifi = checked }
Item {
    id: toggle

    property bool checked: false
    property string glyph: ""
    property string label: ""
    property color accent: "#3a86ffcc"
    signal toggled

    width: 96
    height: 96

    GlassPane {
        anchors.fill: parent
        corner: toggle.height * 0.5
        interactive: true
        active: toggle.checked
        activeTint: toggle.accent
        onClicked: { toggle.checked = !toggle.checked; toggle.toggled() }
    }

    Text {
        text: toggle.glyph
        fontSize: 30
        color: "#ffffff"
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: -9
    }
    Text {
        text: toggle.label
        fontSize: 12
        color: toggle.checked ? "#ffffff" : "#ffffffb3"
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        anchors.bottomMargin: 15
    }
}
