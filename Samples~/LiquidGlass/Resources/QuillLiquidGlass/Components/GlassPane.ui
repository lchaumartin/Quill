//
// GlassPane — one pane of Quill/Effect/LiquidGlass. Every other glass component is built on it.
//
// Public API:
//   interactive (bool)   hover / press feedback and the `clicked` signal (off = purely visual)
//   active      (bool)   lit state: the pane takes `activeTint`
//   restTint, hoverTint, activeTint (color)   tints for each state, "#RRGGBBAA"
//   signal clicked
//   Any LiquidGlass uniform (cornerRadius, refraction, radius, softness) can be overridden.
//
// Children render on top of the glass. Keep glass panes from overlapping each other: effects share
// one render queue, so the order of two overlapping panes is not defined.
ShaderEffect {
    id: pane
    shader: "Quill/Effect/LiquidGlass"

    property bool interactive: false
    property bool active: false
    signal clicked

    property color restTint: "#0a0f1e38"
    property color hoverTint: "#ffffff2e"
    property color activeTint: "#3a86ffcc"

    // Eased state. The sample's QuillTweens moves every `x` toward its `xTarget` each frame, so
    // these read as smooth 0..1 (or colour) transitions instead of hard switches.
    property real hover
    property real hoverTarget: pane.interactive && area.containsMouse ? 1 : 0
    property real press
    property real pressTarget: pane.interactive && area.pressed ? 1 : 0
    property color tint
    property color tintTarget: pane.active ? pane.activeTint : (pane.hoverTarget > 0.5 ? pane.hoverTint : pane.restTint)

    // The lens thickens under the pointer and swells on press.
    cornerRadius: 28
    refraction: 24 + 12 * pane.hover + 18 * pane.press
    radius: 3 + 5 * pane.press
    softness: 1.5

    MouseArea {
        id: area
        anchors.fill: parent
        enabled: pane.interactive
        onClicked: pane.clicked()
    }
}
