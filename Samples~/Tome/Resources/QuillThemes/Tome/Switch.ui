//
// Switch — Tome: an inked slot; a wax seal slides across and reddens when on.
// Same API in every theme: text, checked, enabled, signal toggled
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    width: track.width + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(track.height, label.contentHeight)
    opacity: control.enabled ? 1 : 0.45

    property real position: control.checked ? 1 : 0
    Behavior on position { NumberAnimation { duration: Theme.duration * 1.3; easing.type: Easing.InOutQuad } }

    Rectangle {
        id: track
        width: 46
        height: 22
        radius: 11
        anchors.verticalCenter: parent.verticalCenter
        color: area.containsMouse ? Theme.controlHover : Theme.control
        border.width: Theme.borderWidth
        border.color: Theme.border

        Rectangle {
            width: 20
            height: 20
            radius: 10
            x: 1 + control.position * (track.width - width - 2)
            anchors.verticalCenter: parent.verticalCenter
            color: Qt.tint(Theme.textMuted, Qt.alpha(Theme.accent, control.position))
            border.width: 2
            border.color: Qt.darker(Qt.tint(Theme.textMuted, Qt.alpha(Theme.accent, control.position)), 1.5)
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: track.right
        anchors.leftMargin: 12
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
