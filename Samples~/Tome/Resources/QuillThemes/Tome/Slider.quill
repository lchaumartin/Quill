//
// Slider — Tome: an inked rule with tick marks, a wax-red run and a round seal to drag.
// Same API in every theme: value, from, to, step, enabled, position / pressed (read-only), signal moved
Item {
    id: control

    property real value: 0
    property real from: 0
    property real to: 1
    property real step: 0
    property bool enabled: true
    property bool pressed: area.pressed
    property real position: control.to > control.from ? Math.clamp((control.value - control.from) / (control.to - control.from), 0, 1) : 0
    signal moved

    width: 240
    height: 30
    opacity: control.enabled ? 1 : 0.45

    property real knob: 20
    property real travel: control.width - control.knob
    // One tick per step when stepped (if that's a sensible number), else every tenth.
    property int ticks: control.step > 0 && (control.to - control.from) / control.step <= 20 ? Math.round((control.to - control.from) / control.step) : 10

    function setFromX(px) {
        var t = Math.clamp((px - control.knob / 2) / Math.max(1, control.travel), 0, 1)
        var v = control.from + t * (control.to - control.from)
        if (control.step > 0) v = control.from + Math.round((v - control.from) / control.step) * control.step
        if (v != control.value) { control.value = v; control.moved() }
    }

    // Keyboard / gamepad: Left / Right step the value (by `step`, or a twentieth of the range),
    // Home / End jump to the ends; Up / Down move on to the next control.
    activeFocusOnTab: true
    function moveTo(v) {
        v = Math.clamp(v, Math.min(control.from, control.to), Math.max(control.from, control.to))
        if (v != control.value) { control.value = v; control.moved() }
    }
    function stepBy(n) { control.moveTo(control.value + n * (control.step > 0 ? control.step : (control.to - control.from) / 20)) }
    Keys.onLeftPressed: control.stepBy(-1)
    Keys.onRightPressed: control.stepBy(1)
    Keys.onPressed: {
        if (event.key == Quill.Key_Home) { control.moveTo(control.from); event.accepted = true }
        else if (event.key == Quill.Key_End) { control.moveTo(control.to); event.accepted = true }
    }

    Repeater {
        model: control.ticks + 1
        Rectangle {
            x: control.knob / 2 + index / control.ticks * control.travel - 0.5
            y: control.height / 2 + 4
            width: 1
            height: index % 5 == 0 || control.ticks <= 10 ? 6 : 3
            color: Color.alpha(Theme.border, 0.7)
        }
    }
    Rectangle {
        x: control.knob / 2
        width: control.travel
        height: 2
        anchors.verticalCenter: parent.verticalCenter
        color: Theme.border
    }
    Rectangle {
        x: control.knob / 2
        width: control.position * control.travel
        height: 4
        anchors.verticalCenter: parent.verticalCenter
        color: Theme.accent
    }
    Rectangle {
        property real size: control.knob + (area.pressed ? 3 : 0)
        x: control.knob / 2 + control.position * control.travel - size / 2
        anchors.verticalCenter: parent.verticalCenter
        width: size
        height: size
        radius: size / 2
        color: area.containsMouse || area.pressed ? Color.lighter(Theme.accent, 1.15) : Theme.accent
        border.width: 2
        border.color: Color.darker(Theme.accent, 1.6)

        Rectangle {
            width: parent.width * 0.4
            height: width
            radius: width / 2
            anchors.centerIn: parent
            color: "#00000000"
            border.width: 1
            border.color: Color.alpha(Theme.accentText, 0.6)
        }
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onPressed: control.setFromX(mouse.x)
        onPositionChanged: { if (area.pressed) control.setFromX(mouse.x) }
    }

    FocusRing { visible: control.visualFocus }
}
