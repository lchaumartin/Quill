//
// Label — Tome: Cinzel capitals for titles, wax-red Cinzel headings, EB Garamond text.
// Same API in every theme: text, kind: "title" | "heading" | "body" (default) | "caption"
Text {
    id: label

    property string kind: "body"

    color: label.kind == "heading" ? Theme.accent : label.kind == "caption" ? Theme.textMuted : Theme.text
    font.family: label.kind == "title" || label.kind == "heading" ? Theme.titleFont : Theme.font
    font.italic: label.kind == "caption"
    font.letterSpacing: label.kind == "title" ? 3 : label.kind == "heading" ? 1.5 : 0
    fontSize: label.kind == "title" ? Theme.titleSize
            : label.kind == "heading" ? 18
            : label.kind == "caption" ? 17
            : Theme.fontSize
    lineHeight: 1.2
}
