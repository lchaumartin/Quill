//
// Button — Vector: a hairline box in spaced capitals; brackets snap on when hovered; the
// highlighted one is solid phosphor. Same API in every theme:
//   text, highlighted, enabled, down / hovered (read-only), signal clicked
Rectangle {
    id: control

    property string text: "Button"
    property bool highlighted: false
    property bool enabled: true
    property bool down: area.pressed
    property bool hovered: area.containsMouse
    signal clicked

    width: Math.max(104, label.contentWidth + 36)
    height: 38
    opacity: control.enabled ? 1 : 0.35
    color: control.highlighted ? (control.down ? Qt.darker(Theme.accent, 1.3) : Theme.accent)
                               : (control.down ? Qt.alpha(Theme.accent, 0.3) : control.hovered ? Qt.alpha(Theme.accent, 0.12) : Theme.control)
    border.width: Theme.borderWidth
    border.color: control.highlighted || control.hovered ? Theme.accent : Theme.border

    Brackets {
        anchors.margins: -4
        length: 8
        thickness: 1
        color: Theme.accent
        visible: control.hovered
    }

    Text {
        id: label
        text: control.text
        color: control.highlighted ? Theme.accentText : Theme.text
        fontSize: 14
        font.family: Theme.font
        font.capitalization: Font.AllUppercase
        font.letterSpacing: 2
        anchors.centerIn: parent
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: control.clicked()
    }
}
