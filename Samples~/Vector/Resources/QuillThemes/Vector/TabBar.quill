//
// TabBar — Vector: spaced monospace tabs; the current one is bracketed and underlined.
// Same API in every theme: model (list of strings), currentIndex, enabled, signal activated(int index)
Row {
    id: control

    property var model: []
    property int currentIndex: 0
    property bool enabled: true
    signal activated(int index)

    // Keyboard / gamepad: Tab or the D-pad reaches it; Left / Right switch tabs, and past the
    // first or last tab move on to the neighbouring control.
    activeFocusOnTab: true
    function select(i) { control.currentIndex = i; control.activated(i) }
    Keys.onLeftPressed: {
        if (control.currentIndex > 0) control.select(control.currentIndex - 1)
        else event.accepted = false
    }
    Keys.onRightPressed: {
        if (control.currentIndex < control.model.length - 1) control.select(control.currentIndex + 1)
        else event.accepted = false
    }

    spacing: 8
    opacity: control.enabled ? 1 : 0.35

    Repeater {
        model: control.model

        Item {
            width: tabLabel.contentWidth + 26
            height: 34

            Rectangle {
                width: parent.width
                height: parent.height
                color: index == control.currentIndex ? Color.alpha(Theme.accent, 0.1) : tabArea.containsMouse ? Theme.controlHover : Color.alpha(Theme.controlHover, 0)
            }
            Brackets {
                length: 7
                thickness: 1
                visible: index == control.currentIndex
            }
            Text {
                id: tabLabel
                text: modelData
                color: index == control.currentIndex ? Theme.accent : tabArea.containsMouse ? Theme.text : Theme.textMuted
                fontSize: 13
                font.family: Theme.font
                font.capitalization: Font.AllUppercase
                font.letterSpacing: 2
                anchors.centerIn: parent
            }
            MouseArea {
                id: tabArea
                anchors.fill: parent
                hoverEnabled: true
                enabled: control.enabled
                onClicked: control.select(index)
            }

            FocusRing { visible: control.visualFocus && index == control.currentIndex; gap: 2 }
        }
    }
}
