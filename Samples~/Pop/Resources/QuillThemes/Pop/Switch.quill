// Switch — Pop: an inked pill that turns pink; the round knob bounces across.
// Same API in every theme: text, checked, enabled, signal toggled
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    width: track.width + 3 + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(track.height + 3, label.contentHeight)
    opacity: control.enabled ? 1 : 0.45

    property real position: control.checked ? 1 : 0
    Behavior on position { SpringAnimation { spring: 6; damping: 0.3 } }

    Rectangle {
        x: 3
        y: track.y + 3
        width: track.width
        height: track.height
        radius: track.radius
        color: Theme.border
    }
    Rectangle {
        id: track
        width: 52
        height: 28
        radius: 14
        anchors.verticalCenter: parent.verticalCenter
        anchors.verticalCenterOffset: -1.5
        color: control.checked ? Theme.accent : area.containsMouse ? Theme.controlHover : Theme.control
        border.width: Theme.borderWidth
        border.color: Theme.border

        Rectangle {
            x: 4 + control.position * (track.width - width - 8)
            anchors.verticalCenter: parent.verticalCenter
            width: 20
            height: 20
            radius: 10
            color: control.checked ? Theme.accentText : Theme.background
            border.width: Theme.borderWidth
            border.color: Theme.border
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: track.right
        anchors.leftMargin: 15
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
