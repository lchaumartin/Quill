//
// Slider — Pop: an inked groove with a pink run and a round knob on a hard shadow.
// Same API in every theme: value, from, to, step, enabled, position / pressed (read-only), signal moved
Item {
    id: control

    property real value: 0
    property real from: 0
    property real to: 1
    property real step: 0
    property bool enabled: true
    property bool pressed: area.pressed
    property real position: control.to > control.from ? Math.clamp((control.value - control.from) / (control.to - control.from), 0, 1) : 0
    signal moved

    width: 240
    height: 32
    opacity: control.enabled ? 1 : 0.45

    property real knob: 26
    property real travel: control.width - control.knob - 3

    function setFromX(px) {
        var t = Math.clamp((px - control.knob / 2) / Math.max(1, control.travel), 0, 1)
        var v = control.from + t * (control.to - control.from)
        if (control.step > 0) v = control.from + Math.round((v - control.from) / control.step) * control.step
        if (v != control.value) { control.value = v; control.moved() }
    }

    Rectangle {
        id: groove
        x: control.knob / 2 - 7
        width: control.travel + 14
        height: 14
        radius: 7
        anchors.verticalCenter: parent.verticalCenter
        color: Theme.control
        border.width: Theme.borderWidth
        border.color: Theme.border

        Rectangle {
            width: 14 + control.position * control.travel
            height: groove.height
            radius: groove.radius
            color: Theme.accent
            border.width: Theme.borderWidth
            border.color: Theme.border
        }
    }

    Item {
        property real lift: area.pressed ? 0 : 3
        x: control.position * control.travel
        y: (control.height - control.knob) / 2 - 1
        width: control.knob
        height: control.knob

        Rectangle {
            x: 3; y: 3
            width: parent.width
            height: parent.height
            radius: width / 2
            color: Theme.border
        }
        Rectangle {
            x: 3 - parent.lift
            y: 3 - parent.lift
            width: parent.width
            height: parent.height
            radius: width / 2
            color: area.containsMouse ? Theme.controlHover : Theme.control
            border.width: Theme.borderWidth
            border.color: Theme.border
        }
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onPressed: control.setFromX(mouse.x)
        onPositionChanged: { if (area.pressed) control.setFromX(mouse.x) }
    }
}
