//
// TabBar — Pop: inked tabs on hard shadows; the current one is pink and pressed flat.
// Same API in every theme: model (list of strings), currentIndex, enabled, signal activated(int index)
Row {
    id: control

    property var model: []
    property int currentIndex: 0
    property bool enabled: true
    signal activated(int index)

    // Keyboard / gamepad: Tab or the D-pad reaches it; Left / Right switch tabs, and past the
    // first or last tab move on to the neighbouring control.
    activeFocusOnTab: true
    function select(i) { control.currentIndex = i; control.activated(i) }
    Keys.onLeftPressed: {
        if (control.currentIndex > 0) control.select(control.currentIndex - 1)
        else event.accepted = false
    }
    Keys.onRightPressed: {
        if (control.currentIndex < control.model.length - 1) control.select(control.currentIndex + 1)
        else event.accepted = false
    }

    spacing: 8
    opacity: control.enabled ? 1 : 0.45

    Repeater {
        model: control.model

        Item {
            property bool current: index == control.currentIndex
            width: Math.max(70, tabLabel.contentWidth + 28) + 4
            height: 42

            Rectangle {
                x: 4; y: 4
                width: parent.width - 4
                height: parent.height - 4
                radius: 10
                color: Theme.border
            }
            Rectangle {
                x: parent.current ? 4 : 0
                y: parent.current ? 4 : 0
                width: parent.width - 4
                height: parent.height - 4
                radius: 10
                color: parent.current ? Theme.accent : tabArea.containsMouse ? Theme.controlHover : Theme.control
                border.width: Theme.borderWidth
                border.color: Theme.border

                Text {
                    id: tabLabel
                    text: modelData
                    color: parent.parent.current ? Theme.accentText : Theme.text
                    fontSize: 20
                    font.family: Theme.titleFont
                    font.letterSpacing: 1
                    anchors.centerIn: parent
                }
            }
            MouseArea {
                id: tabArea
                anchors.fill: parent
                hoverEnabled: true
                enabled: control.enabled
                onClicked: control.select(index)
            }

            FocusRing { visible: control.visualFocus && index == control.currentIndex; gap: 2; radius: 10 + gap }
        }
    }
}
