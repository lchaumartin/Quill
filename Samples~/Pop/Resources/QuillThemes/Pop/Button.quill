//
// Button — Pop: an inked button on a hard shadow; pressing pushes it down onto the shadow. The
// highlighted one is hot pink. Same API in every theme:
//   text, highlighted, enabled, down / hovered (read-only), signal clicked
Item {
    id: control

    property string text: "Button"
    property bool highlighted: false
    property bool enabled: true
    property bool down: area.pressed
    property bool hovered: area.containsMouse
    signal clicked

    width: Math.max(100, label.contentWidth + 40)
    height: 44
    opacity: control.enabled ? 1 : 0.45

    // How far the face sits above its shadow: full at rest, less on hover, none when pressed.
    property real rise: control.down ? 0 : control.hovered ? Theme.shadowOffset * 1.3 : Theme.shadowOffset
    Behavior on rise { NumberAnimation { duration: Theme.duration * 0.6; easing.type: Easing.OutQuad } }

    Rectangle {
        x: Theme.shadowOffset
        y: Theme.shadowOffset
        width: control.width
        height: control.height
        radius: Theme.radius
        color: Theme.border
    }
    Rectangle {
        x: Theme.shadowOffset - control.rise
        y: Theme.shadowOffset - control.rise
        width: control.width
        height: control.height
        radius: Theme.radius
        color: control.highlighted ? Theme.accent : control.hovered ? Theme.controlHover : Theme.control
        border.width: Theme.borderWidth
        border.color: Theme.border

        Text {
            id: label
            text: control.text
            color: control.highlighted ? Theme.accentText : Theme.text
            fontSize: 22
            font.family: Theme.titleFont
            font.letterSpacing: 1
            anchors.centerIn: parent
        }
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: control.clicked()
    }
}
