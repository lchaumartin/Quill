// Panel — Pop: a white card in thick ink on a hard black shadow.
Item {
    id: panel

    width: 340
    height: 200

    Rectangle {
        x: Theme.shadowOffset + 2
        y: Theme.shadowOffset + 2
        width: panel.width
        height: panel.height
        radius: Theme.radius * 1.4
        color: Theme.border
    }
    Rectangle {
        width: panel.width
        height: panel.height
        radius: Theme.radius * 1.4
        color: Theme.surface
        border.width: Theme.borderWidth
        border.color: Theme.border
    }
}
