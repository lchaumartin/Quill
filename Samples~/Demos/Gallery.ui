// Quill — Widget Gallery
// A test bench of interactive widgets, one per card. Each exercises specific engine features so we
// can eyeball regressions as the system grows. Assign this file to QuillDemo's "Quill File" slot.

Rectangle {
    id: root
    color: "#0b0f177f"

    property real load: 0
    property real phase: 0

    NumberAnimation on load  { from: 0.05; to: 0.97; duration: 3000; loops: Animation.Infinite; easing.type: Easing.InOutQuad }
    NumberAnimation on phase { from: 0;    to: 1;    duration: 1200; loops: Animation.Infinite; easing.type: Easing.InOutSine }

    // ---- Header --------------------------------------------------------------------------------
    Rectangle {
        id: header
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 52
        color: "#11182a"
        border.width: 1
        border.color: "#1f2c44"

        Rectangle {
            id: dot
            width: 12; height: 12; radius: 6
            anchors.left: parent.left
            anchors.leftMargin: 18
            anchors.verticalCenter: parent.verticalCenter
            color: "#4fc3f7"
            opacity: 0.4 + 0.6 * phase
        }
        Text {
            text: "QUILL  ·  WIDGET GALLERY"
            color: "#e8eef7"
            fontSize: 19
            anchors.left: dot.right
            anchors.leftMargin: 14
            anchors.verticalCenter: parent.verticalCenter
        }
    }

    // ---- Widget grid ---------------------------------------------------------------------------
    Grid {
        id: grid
        columns: 4
        spacing: 14
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: header.bottom
        anchors.topMargin: 20

        // ========================= 1. BUTTON =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Button"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Rectangle {
                id: btn
                property int count: 0
                width: 210; height: 48; radius: 8
                anchors.centerIn: parent
                color: btnM.pressed ? "#1565c0" : (btnM.containsMouse ? "#1e88e5" : "#22304d")
                border.width: 1; border.color: "#4fc3f7"
                Text { text: "Clicked " + btn.count; color: "#e8eef7"; fontSize: 15; anchors.centerIn: parent }
                MouseArea { id: btnM; anchors.fill: parent; hoverEnabled: true; onClicked: btn.count = btn.count + 1 }
            }
        }

        // ========================= 2. SWITCH =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Switch"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Rectangle {
                id: sw
                property bool on: false
                width: 66; height: 30; radius: 15
                anchors.centerIn: parent
                color: sw.on ? "#2e7d32" : "#37474f"
                Rectangle {
                    width: 24; height: 24; radius: 12; color: "#e8eef7"
                    anchors.verticalCenter: parent.verticalCenter
                    x: sw.on ? 38 : 4
                }
                MouseArea { anchors.fill: parent; onClicked: sw.on = !sw.on }
            }
            Text {
                text: sw.on ? "ON" : "OFF"
                color: sw.on ? "#66bb6a" : "#7d8aa3"
                fontSize: 13
                anchors.horizontalCenter: parent.horizontalCenter
                anchors.top: sw.bottom
                anchors.topMargin: 12
            }
        }

        // ========================= 3. CHECKBOX =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Checkbox"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Rectangle {
                id: cb
                property bool checked: true
                width: 30; height: 30; radius: 6
                anchors.centerIn: parent
                color: "#22304d"
                border.width: 2
                border.color: cb.checked ? "#4fc3f7" : "#3a4a6b"
                Rectangle { width: 16; height: 16; radius: 3; anchors.centerIn: parent; color: "#4fc3f7"; visible: cb.checked }
                MouseArea { anchors.fill: parent; onClicked: cb.checked = !cb.checked }
            }
        }

        // ========================= 4. RADIO GROUP =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Radio group"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Column {
                id: radios
                property int selected: 0
                spacing: 12
                anchors.centerIn: parent

                Repeater {
                    model: 3
                    Row {
                        spacing: 10
                        Rectangle {
                            width: 22; height: 22; radius: 11
                            color: "#22304d"
                            border.width: 2
                            border.color: radios.selected == index ? "#4fc3f7" : "#3a4a6b"
                            Rectangle { width: 10; height: 10; radius: 5; anchors.centerIn: parent; color: "#4fc3f7"; visible: radios.selected == index }
                            MouseArea { anchors.fill: parent; onClicked: radios.selected = index }
                        }
                        Text { text: "option_" + index; color: "#c7d2e4"; fontSize: 14; anchors.verticalCenter: parent.verticalCenter }
                    }
                }
            }
        }

        // ========================= 5. SLIDER (drag) =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Slider"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Rectangle {
                id: slider
                property real value: 0.4
                width: 230; height: 40
                anchors.centerIn: parent
                color: "#141c2e"      // same as card -> invisible hit region

                Rectangle {
                    height: 8; radius: 4
                    anchors.left: parent.left; anchors.right: parent.right
                    anchors.verticalCenter: parent.verticalCenter
                    color: "#37474f"
                    Rectangle { height: 8; radius: 4; anchors.left: parent.left; anchors.verticalCenter: parent.verticalCenter; width: parent.width * slider.value; color: "#4fc3f7" }
                }
                Rectangle {
                    width: 22; height: 22; radius: 11; color: "#e8eef7"
                    anchors.verticalCenter: parent.verticalCenter
                    x: slider.value * slider.width - 11
                }
                MouseArea {
                    id: sm
                    anchors.fill: parent
                    onPressed: slider.value = Math.clamp(sm.mouseX / slider.width, 0, 1)
                    onPositionChanged: slider.value = Math.clamp(sm.mouseX / slider.width, 0, 1)
                }
            }
            Text {
                text: "value  " + (slider.value * 100 - (slider.value * 100) % 1) + " %"
                color: "#9fb3d1"; fontSize: 13
                anchors.horizontalCenter: parent.horizontalCenter
                anchors.bottom: parent.bottom; anchors.bottomMargin: 16
            }
        }

        // ========================= 6. PROGRESS =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Progress (animated)"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Rectangle {
                width: 230; height: 14; radius: 7
                anchors.centerIn: parent
                color: "#37474f"
                Rectangle { height: 14; radius: 7; anchors.left: parent.left; anchors.verticalCenter: parent.verticalCenter; width: parent.width * root.load; color: "#66bb6a" }
            }
        }

        // ========================= 7. STEPPER =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Stepper"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Row {
                id: stepper
                property int val: 5
                spacing: 12
                anchors.centerIn: parent

                Rectangle {
                    width: 42; height: 42; radius: 8
                    color: minus.containsMouse ? "#1e88e5" : "#22304d"
                    border.width: 1; border.color: "#4fc3f7"
                    Text { text: "-"; color: "#e8eef7"; fontSize: 22; anchors.centerIn: parent }
                    MouseArea { id: minus; anchors.fill: parent; hoverEnabled: true; onClicked: stepper.val = stepper.val - 1 }
                }
                Rectangle {
                    width: 64; height: 42; radius: 8; color: "#0f1626"; border.width: 1; border.color: "#243049"
                    Text { text: stepper.val; color: "#e8eef7"; fontSize: 18; anchors.centerIn: parent }
                }
                Rectangle {
                    width: 42; height: 42; radius: 8
                    color: plus.containsMouse ? "#1e88e5" : "#22304d"
                    border.width: 1; border.color: "#4fc3f7"
                    Text { text: "+"; color: "#e8eef7"; fontSize: 20; anchors.centerIn: parent }
                    MouseArea { id: plus; anchors.fill: parent; hoverEnabled: true; onClicked: stepper.val = stepper.val + 1 }
                }
            }
        }

        // ========================= 8. TABS (segmented) =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Tabs"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Row {
                id: tabs
                property int sel: 0
                spacing: 0
                anchors.horizontalCenter: parent.horizontalCenter
                anchors.verticalCenter: parent.verticalCenter
                anchors.verticalCenterOffset: -14

                Repeater {
                    model: 3
                    Rectangle {
                        width: 84; height: 38
                        color: tabs.sel == index ? "#1e88e5" : "#22304d"
                        border.width: 1; border.color: "#243049"
                        Text { text: "tab " + index; color: tabs.sel == index ? "#ffffff" : "#9fb3d1"; fontSize: 13; anchors.centerIn: parent }
                        MouseArea { anchors.fill: parent; onClicked: tabs.sel = index }
                    }
                }
            }
            Text {
                text: "showing tab " + tabs.sel
                color: "#9fb3d1"; fontSize: 13
                anchors.horizontalCenter: parent.horizontalCenter
                anchors.bottom: parent.bottom; anchors.bottomMargin: 20
            }
        }

        // ========================= 9. HOVER CARD =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Hover"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Rectangle {
                id: hc
                width: 210; height: 84; radius: 10
                anchors.centerIn: parent
                color: hcm.containsMouse ? "#1e88e5" : "#22304d"
                border.width: hcm.containsMouse ? 2 : 1
                border.color: hcm.containsMouse ? "#4fc3f7" : "#243049"
                Text { text: hcm.containsMouse ? "hovering!" : "hover me"; color: "#e8eef7"; fontSize: 15; anchors.centerIn: parent }
                MouseArea { id: hcm; anchors.fill: parent; hoverEnabled: true }
            }
        }

        // ========================= 10. METER (Repeater + animation) =========================
        Rectangle {
            width: 300; height: 168; radius: 10; color: "#141c2e"; border.width: 1; border.color: "#243049"
            Text { text: "Meter (animated)"; color: "#7d8aa3"; fontSize: 13; anchors.top: parent.top; anchors.left: parent.left; anchors.margins: 14 }

            Row {
                spacing: 6
                anchors.centerIn: parent
                Repeater {
                    model: 12
                    Rectangle {
                        width: 14; height: 34; radius: 3
                        color: index < root.load * 12
                               ? (index > 8 ? "#ef5350" : (index > 5 ? "#ffca28" : "#66bb6a"))
                               : "#22304d"
                    }
                }
            }
        }
    }
}
