//
// ProgressBar — Frost: a lit glass run and the rest of the track, side by side.
// Same API in every theme: value, from, to, position (read-only)
Item {
    id: control

    property real value: 0
    property real from: 0
    property real to: 1
    property real position: control.to > control.from ? Math.clamp((control.value - control.from) / (control.to - control.from), 0, 1) : 0

    width: 240
    height: 12

    property real split: control.width * control.position

    FrostPane {
        width: Math.max(0, control.split - 2)
        height: control.height
        corner: height / 2
        visible: width > control.height * 0.5
        active: true
    }

    FrostPane {
        x: control.position > 0 ? control.split + 2 : 0
        width: Math.max(0, control.width - x)
        height: control.height
        corner: height / 2
        visible: width > control.height * 0.5
    }
}
