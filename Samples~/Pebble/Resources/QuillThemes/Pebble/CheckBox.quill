//
// CheckBox — Pebble: a soft rounded tile; checking fills it with coral and pops a dot in.
// Same API in every theme: text, checked, enabled, signal toggled
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    // Keyboard / gamepad: Tab or the D-pad reaches it; Space / Return (gamepad South) toggles.
    activeFocusOnTab: true
    function toggle() { control.checked = !control.checked; control.toggled() }
    Keys.onSpacePressed: control.toggle()
    Keys.onReturnPressed: control.toggle()
    Keys.onEnterPressed: control.toggle()

    width: box.width + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(box.height, label.contentHeight)
    opacity: control.enabled ? 1 : 0.45

    property real mark: control.checked ? 1 : 0
    Behavior on mark { SpringAnimation { spring: 6; damping: 0.3 } }

    Rectangle {
        id: box
        width: 26
        height: 26
        radius: 9
        anchors.verticalCenter: parent.verticalCenter
        color: Color.tint(area.containsMouse ? Theme.controlHover : Theme.control, Color.alpha(Theme.accent, Math.clamp(control.mark, 0, 1)))

        Rectangle {
            width: 10 * control.mark
            height: width
            radius: width / 2
            anchors.centerIn: parent
            color: Theme.accentText
            visible: width > 0.5
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: box.right
        anchors.leftMargin: 12
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: control.toggle()
    }

    FocusRing { visible: control.visualFocus }
}
