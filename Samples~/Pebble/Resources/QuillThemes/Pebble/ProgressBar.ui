// ProgressBar — Pebble: a soft groove filling with a coral pill.
// Same API in every theme: value, from, to, position (read-only)
Rectangle {
    id: control

    property real value: 0
    property real from: 0
    property real to: 1
    property real position: control.to > control.from ? Math.clamp((control.value - control.from) / (control.to - control.from), 0, 1) : 0

    width: 240
    height: 14
    radius: 7
    color: Theme.control

    Rectangle {
        x: 2; y: 2
        width: Math.max(control.height - 4, (control.width - 4) * control.position)
        height: control.height - 4
        radius: height / 2
        color: Theme.accent
        visible: control.position > 0
    }
}
