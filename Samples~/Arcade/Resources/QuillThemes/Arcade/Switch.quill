// Switch — Arcade: a squared neon track; the block snaps across and ignites when on.
// Same API in every theme: text, checked, enabled, signal toggled
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    width: track.width + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(track.height, label.contentHeight)
    opacity: control.enabled ? 1 : 0.35

    property real position: control.checked ? 1 : 0
    Behavior on position { NumberAnimation { duration: Theme.duration * 1.5; easing.type: Easing.OutQuad } }

    Rectangle {
        id: track
        width: 48
        height: 24
        radius: Theme.radius
        anchors.verticalCenter: parent.verticalCenter
        color: area.containsMouse ? Theme.controlHover : Theme.control
        border.width: Theme.borderWidth
        border.color: control.checked ? Theme.accent : Theme.border

        Rectangle {
            x: 3 + control.position * (track.width - width - 6) - 4
            y: -1
            width: 24
            height: 26
            radius: 3
            softness: 14
            color: Qt.alpha(Theme.accent, 0.7 * control.position * Theme.glow)
        }
        Rectangle {
            x: 4 + control.position * (track.width - width - 8)
            anchors.verticalCenter: parent.verticalCenter
            width: 16
            height: 16
            radius: 2
            color: Qt.tint(Theme.border, Qt.alpha(Theme.accent, control.position))
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: track.right
        anchors.leftMargin: 12
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
