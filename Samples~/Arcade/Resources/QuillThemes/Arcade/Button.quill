// Button — Arcade: an Orbitron-lettered neon outline that glows on hover and flashes when pressed;
// the highlighted one is solid cyan. Same API in every theme:
//   text, highlighted, enabled, down / hovered (read-only), signal clicked
Item {
    id: control

    property string text: "Button"
    property bool highlighted: false
    property bool enabled: true
    property bool down: area.pressed
    property bool hovered: area.containsMouse
    signal clicked

    width: Math.max(110, label.contentWidth + 40)
    height: 42
    opacity: control.enabled ? 1 : 0.35

    property color neon: control.highlighted ? Theme.accent : Theme.border
    property real lit: control.down ? 1 : control.hovered ? 0.75 : control.highlighted ? 0.45 : 0
    Behavior on lit { NumberAnimation { duration: Theme.duration } }

    Rectangle {
        x: -3; y: -3
        width: control.width + 6
        height: control.height + 6
        radius: Theme.radius + 3
        softness: 18
        color: Qt.alpha(control.neon, 0.55 * control.lit * Theme.glow)
    }
    Rectangle {
        width: control.width
        height: control.height
        radius: Theme.radius
        color: control.highlighted ? (control.down ? Qt.lighter(Theme.accent, 1.3) : Theme.accent)
                                   : (control.down ? Qt.alpha(Theme.border, 0.35) : control.hovered ? Theme.controlHover : Theme.control)
        border.width: Theme.borderWidth
        border.color: control.neon
    }

    Text {
        id: label
        text: control.text
        color: control.highlighted ? Theme.accentText : Theme.text
        fontSize: 13
        font.family: Theme.titleFont
        font.capitalization: Font.AllUppercase
        font.letterSpacing: 2
        anchors.centerIn: parent
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: control.clicked()
    }
}
