// CheckBox — Bitmap: a sunken pixel well with a gold block inside when checked.
// Same API in every theme: text, checked, enabled, signal toggled
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    width: box.width + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(box.height, label.contentHeight)
    opacity: control.enabled ? 1 : 0.4

    PixelBlock {
        id: box
        width: 8 * Theme.pixel
        height: 8 * Theme.pixel
        anchors.verticalCenter: parent.verticalCenter
        sunken: true
        color: area.containsMouse ? Theme.controlHover : Theme.control

        PixelBlock {
            x: 2 * Theme.pixel
            y: 2 * Theme.pixel
            width: 4 * Theme.pixel
            height: 4 * Theme.pixel
            color: Theme.accent
            outline: Theme.accent
            visible: control.checked
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: box.right
        anchors.leftMargin: 12
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
