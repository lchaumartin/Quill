//
// Switch — Bitmap: a sunken pixel slot; the lever block jumps across (no tween: pixels snap).
// Same API in every theme: text, checked, enabled, signal toggled
Item {
    id: control

    property string text: ""
    property bool checked: false
    property bool enabled: true
    signal toggled

    width: track.width + (control.text.length > 0 ? 12 + label.contentWidth : 0)
    height: Math.max(track.height, label.contentHeight)
    opacity: control.enabled ? 1 : 0.4

    PixelBlock {
        id: track
        width: 16 * Theme.pixel
        height: 8 * Theme.pixel
        anchors.verticalCenter: parent.verticalCenter
        sunken: true
        color: control.checked ? Qt.darker(Theme.accent, 1.6) : Theme.control

        PixelBlock {
            x: control.checked ? track.width - width - Theme.pixel : Theme.pixel
            y: Theme.pixel
            width: 7 * Theme.pixel
            height: 6 * Theme.pixel
            color: control.checked ? Theme.accent : (area.containsMouse ? Theme.text : Theme.textMuted)
        }
    }

    Text {
        id: label
        text: control.text
        color: Theme.text
        fontSize: Theme.fontSize
        font.family: Theme.font
        anchors.left: track.right
        anchors.leftMargin: 12
        anchors.verticalCenter: parent.verticalCenter
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
