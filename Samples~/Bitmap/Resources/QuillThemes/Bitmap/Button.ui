//
// Button — Bitmap: a raised pixel block that sinks one pixel when pressed; the highlighted one is
// gold. Same API in every theme: text, highlighted, enabled, down / hovered (read-only), signal clicked
Item {
    id: control

    property string text: "Button"
    property bool highlighted: false
    property bool enabled: true
    property bool down: area.pressed
    property bool hovered: area.containsMouse
    signal clicked

    width: Math.max(96, Math.ceil((label.contentWidth + 36) / Theme.pixel) * Theme.pixel)
    height: 14 * Theme.pixel
    opacity: control.enabled ? 1 : 0.4

    PixelBlock {
        x: Theme.pixel
        y: Theme.pixel
        width: control.width
        height: control.height
        color: Theme.border
        bevel: false
        visible: !control.down
    }
    PixelBlock {
        id: face
        x: control.down ? Theme.pixel : 0
        y: control.down ? Theme.pixel : 0
        width: control.width
        height: control.height
        sunken: control.down
        color: control.highlighted ? (control.hovered ? Qt.lighter(Theme.accent, 1.12) : Theme.accent)
                                   : (control.hovered ? Theme.controlHover : Theme.control)

        Text {
            id: label
            text: control.text
            color: control.highlighted ? Theme.accentText : Theme.text
            fontSize: 18
            font.family: "QuillThemes/Bitmap/Fonts/PixelifySans-SemiBold"
            anchors.centerIn: parent
        }
    }

    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: control.enabled
        onClicked: control.clicked()
    }
}
